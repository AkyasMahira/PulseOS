# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
JWT_SECRET=change-this-to-a-long-random-string
# WARNING: Must override in production. App will crash if default is used in production mode.

# ── Auto-seed Owner Account (first boot only) ─────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=changeme
# Creates the owner account on first boot if no users exist in the database.

# ── CORS ─────────────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:4321
# Frontend origin. Used by CORS headers, WebSocket auth, and invite URL generation.

# ── Metrics Collection ───────────────────────────────────────────────────────
COLLECT_INTERVAL_MS=5000
WATCH_SERVICES=nginx,ssh,cron
WATCH_PM2=true
HISTORY_RETENTION_DAYS=30

# ── Docker ───────────────────────────────────────────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock
# Linux-only. Override for non-standard Docker socket path.

# ── Database (optional) ──────────────────────────────────────────────────────
# DB_PATH=apps/api/data/pulseos.db
# Default works out-of-the-box. Uncomment to override location.

# ── Public Status Page ───────────────────────────────────────────────────────
STATUS_PAGE_TITLE=System Status
STATUS_PAGE_DESC=Real-time service status
# Can also be configured via Dashboard → Settings (saved to DB, overrides .env).

# ── Alert Notifications (optional) ───────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABCdef
# TELEGRAM_CHAT_ID=-100123456
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Can also be configured via Dashboard → Settings (saved to DB, takes priority over .env).
